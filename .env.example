# AI Provider Configuration
# Set to 'gemini', 'mock', etc.
AI_PROVIDER=mock

# Gemini API Key (Required when AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Database Configuration
DATABASE_PATH=./bytehouse.db

# Global Hotkey (Defaults to Control+Option+Space so it does NOT conflict with Spotlight)
# Options: 'Control+Option+Space', 'CommandOrControl+Shift+Space', etc.
GLOBAL_SHORTCUT=Control+Option+Space
