# ByteHouse Environment Configuration

# Database path (defaults to ~/Library/Application Support/ByteHouse/bytehouse.db)
# DATABASE_PATH=/custom/path/to/bytehouse.db

# Logging level: DEBUG, INFO, WARN, ERROR (defaults to INFO)
LOG_LEVEL=INFO

# AI Provider: mock, gemini, openai (defaults to mock)
AI_PROVIDER=mock

# Gemini Model: defaults to gemini-3.6-flash (or gemini-1.5-flash, gemini-2.5-flash)
# GEMINI_MODEL=gemini-3.6-flash

# API Keys (required when using live providers in Stage 2)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Global Summon Hotkey (defaults to ⌃⌥ Space)
HOTKEY="⌃⌥ Space"
